// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                              String                        @id
  name                            String
  email                           String
  emailVerified                   Boolean                       @default(false)
  image                           String?
  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt
  onboarded                       Boolean                       @default(false)
  
  sessions                        Session[]
  accounts                        Account[]
  members                         Member[]
  invitations                     Invitation[]
  profiles                        UserProfile[]
  assignedTasksTo                 Task[]                        @relation("TaskAssignedTo")
  assignedTasksBy                 Task[]                        @relation("TaskAssignedBy")
  assignedTargets                 Target[]                      @relation("TargetAssignedTo")
  createdByTargets                Target[]                      @relation("TargetCreatedBy")
  targetEntries                   TargetEntry[]                 @relation("TargetEntryUser")
  aiInsights                      AIInsight[]
  performances                    Performance[]
  performanceSnapshots            PerformanceSnapshot[]
  createdTemplates                ReviewTemplate[]              @relation("TemplateCreatedBy")
  createdCycles                   ReviewCycle[]                 @relation("CycleCreatedBy")
  reviewAsReviewee                PerformanceReview[]           @relation("ReviewReviewee")
  reviewAsReviewer                PerformanceReview[]           @relation("ReviewReviewer")
  nominationsGiven                PeerNomination[]              @relation("NominationNominator")
  nominationsReceived             PeerNomination[]              @relation("NominationNominee")
  nominationReviewed              PeerNomination[]              @relation("NominationReviewedBy")
  claibrationsLed                 CalibrationSession[]          @relation("CalibrationFacilitator")
  recognitionsGiven               Recognition[]                 @relation("RecognitionFrom")
  recognitionsReceived            Recognition[]                 @relation("RecognitionTo")
  complaintsSubmitted             Complaint[]                   @relation("ComplaintSubmittedBy")
  complaintsResolved              Complaint[]                   @relation("ComplaintResolvedBy")
  complaintsTargeted              ComplaintTarget[]             @relation("ComplaintTarget")
  notifications                   Notification[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id            String   @id
  identifier    String
  value         String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                        String                @id
  name                      String
  slug                      String
  logo                      String?
  createdAt                 DateTime
  metadata                  String?
  notificationEmailPrefs    Json                  @default("[\"OVERDUE_ALERT\", \"DEADLINE_WARNING\", \"COMPLAINT_CREATED\", \"TARGET_MISSED\"]")
  
  members                   Member[]
  invitations               Invitation[]
  departments               Department[]
  targets                   Target[]
  performances              Performance[]
  performanceSnapshots      PerformanceSnapshot[]
  aiInsights                AIInsight[]
  reviewTemplates           ReviewTemplate[]
  reviewCycles              ReviewCycle[]
  performanceReviews        PerformanceReview[]
  peerNominations           PeerNomination[]
  calibrationSessions       CalibrationSession[]
  recognitions              Recognition[]
  complaints                Complaint[]
  notifications             Notification[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id                  String       @id
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                Role         @default(member)
  createdAt           DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

enum Role {
  owner 
  admin
  supervisor
  member
}

model Invitation {
  id                  String       @id
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email               String
  role                String?
  status              String       @default("pending")
  expiresAt           DateTime
  createdAt           DateTime     @default(now())
  inviterId           String
  user                User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model UserProfile {
  id                  String           @id @default(uuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId      String
  departmentId        String?
  department          Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  supervisorId        String?
  status              UserStatus       @default(active)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([supervisorId])
  @@map("user_profile")
}

enum UserStatus {
  active
  inactive
  onLeave
}

model Department {
  id                          String                      @id @default(uuid())
  organizationId              String
  organization                Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                        String
  description                 String?
  headId                      String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  staff                       UserProfile[]
  tasks                       Task[]
  targets                     Target[]
  calibrationSessions         CalibrationSession[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("department")
}

model Task {
  id                  String           @id @default(uuid())
  organizationId      String
  title               String
  description         String?
  status              TaskStatus       @default(NOT_STARTED)
  priority            Priority         @default(MEDIUM)
  deadline            DateTime?
  completedAt         DateTime?
  assignedToId        String
  assignedTo          User      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedById        String
  assignedBy          User      @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  departmentId        String?
  dependsOnTaskId     String?
  estimatedHours      Float?
  actualHours         Float?
  tags                String[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  department          Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  dependsOn           Task?            @relation("TaskDependency", fields: [dependsOnTaskId], references: [id])
  dependents          Task[]           @relation("TaskDependency")
  subTasks            SubTask[]
  comments            TaskComment[]
  attachments         TaskAttachment[]

  @@index([organizationId])
  @@index([assignedToId])
  @@index([departmentId])
  @@index([status])
  @@index([priority])
  @@index([deadline])
  @@map("task")
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  COMPLETED_LATE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model SubTask {
  id                  String           @id @default(uuid())
  taskId              String
  title               String
  isCompleted         Boolean          @default(false)
  order               Int
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  task                Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtask")
}

model TaskComment {
  id                  String           @id @default(uuid())
  taskId              String
  userId              String
  content             String
  parentCommentId     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  task                Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent              TaskComment?    @relation("Replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies             TaskComment[]   @relation("Replies")

  @@index([taskId])
  @@index([parentCommentId])
  @@map("task_comment")
}

model TaskAttachment {
  id                  String      @id @default(uuid())
  taskId              String
  fileUrl             String
  fileName            String
  fileSize            Int
  uploadedById        String
  createdAt           DateTime    @default(now())
  task                Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachment")
}

model Target {
  id                    String           @id @default(uuid())
  organizationId        String
  title                 String
  description           String?
  type                  TargetType       @default(COMPANY)
  parentTargetId        String?
  targetValue           Float
  currentValue          Float            @default(0)
  status                TargetStatus       @default(ON_TRACK)
  period                String?
  deadline              DateTime
  assignedToId          String?
  createdById           String
  departmentId          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent                Target?         @relation("TargetAlignment", fields: [parentTargetId], references: [id])
  children              Target[]        @relation("TargetAlignment")
  entries               TargetEntry[]
  assignedTo            User?           @relation("TargetAssignedTo", fields: [assignedToId], references: [id])
  createdBy             User            @relation("TargetCreatedBy", fields: [createdById], references: [id])
  department            Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, title, period])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([departmentId])
  @@index([type])
  @@index([status])
  @@index([parentTargetId])
  @@index([period])
  @@map("target")
}

model TargetEntry {
  id                    String       @id @default(uuid())
  targetId              String
  userId                String
  value                 Float
  note                  String?
  attachmentUrl         String?
  attachmentName        String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  target                Target         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  user                  User           @relation("TargetEntryUser", fields: [userId], references: [id])

  @@index([targetId])
  @@index([userId])
  @@map("target_entry")
}

enum TargetType {
  COMPANY
  TEAM
  INDIVIDUAL
}

enum TargetStatus {
  ON_TRACK
  AT_RISK
  COMPLETED
  MISSED
}

model Performance {
  id                          String           @id @default(uuid())
  organizationId              String
  userId                      String
  taskCompleted               Int              @default(0)
  tasksOnTime                 Int              @default(0)
  tasksCompletedLate          Int              @default(0)
  tasksLate                   Int              @default(0)
  totalTasksAssigned          Int              @default(0)
  performanceScore            Float            @default(50)
  rating                      String           @default("Average")
  reviewScore                 Float?
  lastReviewCycleId           String?
  updatedAt                   DateTime         @updatedAt

  organization                Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots                   PerformanceSnapshot[]
  lastReviewCycle             ReviewCycle?      @relation("PerformanceLastCycle", fields: [lastReviewCycleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("performance")
}

model PerformanceSnapshot {
  id                          String           @id @default(uuid())
  performanceId               String
  organizationId              String
  userId                      String
  period                      String
  taskCompleted               Int              
  tasksOnTime                 Int              
  tasksCompletedLate          Int              
  tasksLate                   Int              
  totalTasksAssigned          Int              
  performanceScore            Float            
  rating                      String
  lastReviewCycleId           String?
  createdAt                   DateTime         @default(now())

  performance                 Performance      @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  organization                Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReviewCycle             ReviewCycle?      @relation("PerformanceSnapshotLastCycle", fields: [lastReviewCycleId], references: [id])

  @@unique([organizationId, userId, period])
  @@index([organizationId])
  @@index([userId])
  @@index([performanceId])
  @@map("performance_snapshot")
}

model AIInsight {
  id                          String                @id @default(uuid())
  organizationId              String
  userId                      String
  type                        String
  context                     Json
  response                    String
  createdAt                   DateTime              @default(now())

  organization                Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("ai_insight")
}

model ReviewTemplate {
  id                          String           @id @default(uuid())
  organizationId              String
  title                       String
  description                 String?
  sections                    Json
  isDefault                   Boolean          @default(false)
  createdById                 String

  organization                Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy                   User             @relation("TemplateCreatedBy",fields: [createdById], references: [id], onDelete: Cascade)
  reviewCycles                ReviewCycle[]

  @@index([organizationId])
  @@map("review_template")
}

model ReviewCycle {
  id                          String                  @id @default(uuid())
  organizationId              String
  templateId                  String
  name                        String
  startDate                   DateTime
  endDate                     DateTime
  status                      ReviewCycleStatus       @default(DRAFT)
  templateSnapshot            Json?
  excludedUserIds             String[]               @default([])
  createdById                 String
  createdAt                   DateTime               @default(now())

  organization                Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template                    ReviewTemplate          @relation(fields: [templateId], references: [id])
  createdBy                   User                    @relation("CycleCreatedBy",fields: [createdById], references: [id], onDelete: Cascade)
  
  reviews                     PerformanceReview[]
  nominations                 PeerNomination[]
  calibrations                CalibrationSession[]
  linkedPerformances          Performance[]           @relation("PerformanceLastCycle")
  linkedPerformancesSnapshot  PerformanceSnapshot[]   @relation("PerformanceSnapshotLastCycle")

  @@index([organizationId])
  @@map("review_cycle")
}

model PerformanceReview {
  id                          String                    @id @default(uuid())
  reviewCycleId               String
  organizationId              String
  revieweeId                  String
  reviewerId                  String
  type                        ReviewType
  responses                   Json?
  overallScore                Float?
  status                      ReviewSubmissionStatus    @default(PENDING)
  submittedAt                 DateTime?
  createdAt                   DateTime                  @default(now())

  reviewCycle                 ReviewCycle               @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  organization                Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewee                    User                      @relation("ReviewReviewee", fields: [revieweeId], references: [id])
  reviewer                    User                      @relation("ReviewReviewer", fields: [reviewerId], references: [id])

  @@unique([reviewCycleId, revieweeId, reviewerId])
  @@index([reviewCycleId])
  @@index([revieweeId])
  @@index([reviewerId])
  @@map("performance_review")
}

model PeerNomination {
  id                          String              @id @default(uuid())
  reviewCycleId               String
  organizationId              String
  nominatorId                 String
  nomineeId                   String
  status                      NominationStatus    @default(PENDING)
  reviewedById                String?
  createdAt                   DateTime            @default(now())

  reviewCycle                 ReviewCycle         @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  organization                Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nominator                   User                @relation("NominationNominator", fields: [nominatorId], references: [id])
  nominee                     User                @relation("NominationNominee", fields: [nomineeId], references: [id])
  reviewedBy                  User?               @relation("NominationReviewedBy", fields: [reviewedById], references: [id])

  @@unique([reviewCycleId, nominatorId, nomineeId])
  @@map("peer_nomination")
}

model CalibrationSession {
  id                            String                  @id @default(uuid())
  reviewCycleId               String
  organizationId              String
  departmentId                String?
  facilitatorId               String
  adjustedScores              Json                      @default("{}")
  status                      String                    @default("in_progress")
  finalizedAt                 DateTime?
  createdAt                   DateTime                  @default(now())

  reviewCycle                 ReviewCycle               @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  organization                Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department                  Department?               @relation(fields: [departmentId], references: [id])
  facilitator                 User                      @relation("CalibrationFacilitator", fields: [facilitatorId], references: [id])

  @@index([reviewCycleId])
  @@map("calibration_session")
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CALIBRATING
  COMPLETED
}

enum ReviewType {
  SELF
  MANAGER
  PEER
  UPWARD
}

enum ReviewSubmissionStatus {
  PENDING
  SUBMITTED
  OVERDUE
}
enum NominationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Recognition {
  id                          String                  @id @default(uuid())
  organizationId              String
  fromUserId                  String
  toUserId                    String
  message                     String
  category                    RecognitionCategory
  customCategory              String?
  isPublic                    Boolean             @default(true)
  createdAt                   DateTime            @default(now())

  organization                Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUser                    User                @relation("RecognitionFrom", fields: [fromUserId], references: [id])
  toUser                      User                @relation("RecognitionTo", fields: [toUserId], references: [id])

  @@index([organizationId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("recognition")
}

model Complaint {
  id                          String                  @id @default(uuid())
  organizationId              String
  title                       String
  description                 String
  category                    ComplaintCategory       @default(BUG)
  priority                    Priority                @default(MEDIUM)
  status                      ComplaintStatus         @default(OPEN)
  resolution                  String?
  resolvedAt                  DateTime?
  userId                      String
  resolvedById                String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  organization                Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy                 User                    @relation("ComplaintSubmittedBy", fields: [userId], references: [id])
  resolvedBy                  User?                   @relation("ComplaintResolvedBy", fields: [resolvedById], references: [id])
  targets                     ComplaintTarget[]       
  

  @@index([organizationId])
  @@index([userId])
  @@map("complaint")
}

model ComplaintTarget {
  id              String        @id @default(uuid())
  complaintId     String
  userId          String

  complaint       Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user            User            @relation("ComplaintTarget", fields: [userId], references: [id])

  @@unique([complaintId, userId])
  @@index([complaintId])
  @@index([userId])
  @@map("complaint_target")
}

enum RecognitionCategory {
  TEAMWORK
  INNOVATION
  LEADERSHIP
  CUSTOMER_FOCUS
  GOING_ABOVE_AND_BEYOND
  OTHER
}

enum ComplaintCategory {
  BUG
  COMPLAINT
  SUGGESTION
  ERROR
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  LATE
  RESOLVED
  DISMISSED
}

model Notification {
  id                          String                    @id @default(uuid())
  organizationId              String
  userId                      String
  type                        NotificationType
  severity                    NotificationSeverity      @default(INFO)
  title                       String
  message                     String
  isRead                      Boolean                   @default(false)
  relatedTaskId               String?
  relatedEntityId             String?
  relatedEntityType           String?
  readAt                      DateTime?
  createdAt                   DateTime                  @default(now())

  organization                Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notification")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  DEADLINE_WARNING
  OVERDUE_ALERT
  TARGET_MISSED
  TARGET_AT_RISK
  COMPLAINT_CREATED
  COMPLAINT_STATUS_CHANGED
  REVIEW_ASSIGNED
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
  SUCCESS
  CRITICAL
}